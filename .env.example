# Postgres / TigerData (Timescale). Leave empty to use embedded PGlite in ./data/pglite
DATABASE_URL=

# MBTA V3 API key (https://api-v3.mbta.com) - works without one at low rate limits
MBTA_API_KEY=

# CARTO Basemaps key for background tiles on /map (sent by the browser)
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# Gemini via Mastra (photo matching, abilities, Prof. Crimson chat)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# Google Places API (New) - only for `npm run seed:places`
GOOGLE_PLACES_API_KEY=

# Solana devnet ledger for points + badges. JSON array secret key of a funded devnet wallet
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# S3-compatible object storage for photos. Leave empty to store in ./data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
